+    /// Commits Unicode text received from an Android IME. Using a Unicode
+    /// keyboard event preserves composed text (including CJK and emoji) instead
+    /// of pretending every character has a US keyboard virtual-key mapping.
+    func handleText(_ text: String) {
+        guard !text.isEmpty,
+              let down = CGEvent(keyboardEventSource: source, virtualKey: 0, keyDown: true),
+              let up = CGEvent(keyboardEventSource: source, virtualKey: 0, keyDown: false) else { return }
+        let units = Array(text.utf16)
+        units.withUnsafeBufferPointer { buf in
+            down.keyboardSetUnicodeString(stringLength: units.count, unicodeString: buf.baseAddress!)
+            up.keyboardSetUnicodeString(stringLength: units.count, unicodeString: buf.baseAddress!)
+        }
+        down.post(tap: .cghidEventTap)
+        up.post(tap: .cghidEventTap)
+    }
