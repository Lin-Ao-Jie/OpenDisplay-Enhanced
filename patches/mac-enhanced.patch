+    private func startLocalMouseReturn() {
+        guard UserDefaults.standard.object(forKey: "returnCursorToMainOnLocalInput") as? Bool ?? true else { return }
+        let mask = CGEventMask(1 << CGEventType.mouseMoved.rawValue)
+        let refcon = Unmanaged.passUnretained(self).toOpaque()
+        guard let tap = CGEvent.tapCreate(tap: .cgSessionEventTap,
+                                          place: .headInsertEventTap,
+                                          options: .listenOnly,
+                                          eventsOfInterest: mask,
+                                          callback: { _, type, event, refcon in
+            guard type == .mouseMoved, let refcon else { return Unmanaged.passUnretained(event) }
+            let me = Unmanaged<InputInjector>.fromOpaque(refcon).takeUnretainedValue()
+            guard me.remoteOwnsCursor,
+                  event.getIntegerValueField(.eventSourceUserData) != me.syntheticMarker else {
+                return Unmanaged.passUnretained(event)
+            }
+            me.reclaimCursorToMain(from: event.location)
+            return Unmanaged.passUnretained(event)
+        }, userInfo: refcon) else { return }
+        localMouseTap = tap
+        let src = CFMachPortCreateRunLoopSource(kCFAllocatorDefault, tap, 0)
+        localMouseTapSource = src
+        CFRunLoopAddSource(CFRunLoopGetMain(), src, .commonModes)
+        CGEvent.tapEnable(tap: tap, enable: true)
+    }
+
+    private func stopLocalMouseReturn() {
+        if let src = localMouseTapSource { CFRunLoopRemoveSource(CFRunLoopGetMain(), src, .commonModes) }
+        if let tap = localMouseTap { CGEvent.tapEnable(tap: tap, enable: false) }
+        localMouseTapSource = nil
+        localMouseTap = nil
+    }
+
+    private func reclaimCursorToMain(from p: CGPoint) {
+        remoteOwnsCursor = false // disarm before warping so the warp cannot recurse
+        let tablet = CGDisplayBounds(displayID)
+        let main = CGDisplayBounds(CGMainDisplayID())
+        guard tablet.width > 0, tablet.height > 0, main.width > 4, main.height > 4 else { return }
+
+        let nx = min(1, max(0, (p.x - tablet.minX) / tablet.width))
+        let ny = min(1, max(0, (p.y - tablet.minY) / tablet.height))
+        let inset: CGFloat = 2
+        var target = CGPoint(x: main.minX + nx * main.width,
+                             y: main.minY + ny * main.height)
+
+        // Enter the main display from the edge physically nearest the tablet.
+        if tablet.minX >= main.maxX {
+            target.x = main.maxX - inset
+        } else if tablet.maxX <= main.minX {
+            target.x = main.minX + inset
+        } else if tablet.minY >= main.maxY {
+            target.y = main.maxY - inset
+        } else if tablet.maxY <= main.minY {
+            target.y = main.minY + inset
+        }
+        target.x = min(main.maxX - inset, max(main.minX + inset, target.x))
+        target.y = min(main.maxY - inset, max(main.minY + inset, target.y))
+        CGWarpMouseCursorPosition(target)
     }
 
