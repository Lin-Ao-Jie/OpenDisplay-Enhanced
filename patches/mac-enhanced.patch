+    /// Editing keys that cannot be represented as committed Unicode text.
+    func handleKey(_ key: String) {
+        let code: CGKeyCode
+        switch key {
+        case "backspace": code = 51
+        case "enter": code = 36
+        case "tab": code = 48
+        case "escape": code = 53
+        case "left": code = 123
+        case "right": code = 124
+        case "down": code = 125
+        case "up": code = 126
+        default: return
+        }
+        CGEvent(keyboardEventSource: source, virtualKey: code, keyDown: true)?.post(tap: .cghidEventTap)
+        CGEvent(keyboardEventSource: source, virtualKey: code, keyDown: false)?.post(tap: .cghidEventTap)
+    }
